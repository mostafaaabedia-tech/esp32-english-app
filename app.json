{
  "expo": {
    "name": "Speak It Right",
    "slug": "speak-it-right",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": ["android"],
    "plugins": [
      [
        "react-native-ble-plx",
        { "isBackgroundEnabled": false, "neverForLocation": true }
      ],
      [
        "@react-native-voice/voice",
        {
          "microphonePermission": "Speak It Right needs the microphone to hear you read.",
          "speechRecognitionPermission": "Speak It Right uses speech recognition to check your reading."
        }
      ],
      "./plugins/withSpeechQueries",
      "./plugins/withSplashColor"
    ],
    "android": {
      "package": "com.example.speakitright",
      "versionCode": 1,
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    }
  }
}
